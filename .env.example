# ==========================================
# FACELESS YOUTUBE SHORTS AUTOMATION CONFIG
# ==========================================

# Gemini API Key for Topic Research, Script Writing & SEO Generation
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# YouTube Data API Credentials (Optional - only needed for auto-uploading)
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 Client ID (Desktop Application)
# 4. Download client_secrets.json to project root
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Channel Defaults
DEFAULT_NICHE=Psychology Facts
DEFAULT_VOICE=en-US-ChristopherNeural
DEFAULT_VISUAL_STYLE=cinematic dark atmospheric hyper-realistic 8k
AUTO_UPLOAD_DEFAULT=false
PRIVACY_STATUS=private
